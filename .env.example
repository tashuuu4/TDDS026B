# LLM API Call Optimizer Configuration

# Server Settings
APP_NAME=LLM API Call Optimizer
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration
# Set to 'mock' for self-contained execution with zero external API dependencies.
# Set to 'openai' or 'gemini' if you want to use real LLM keys.
DEFAULT_LLM_PROVIDER=mock
MOCK_SIMULATE_LATENCY=true

# Optional API Keys for Real Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cache Settings
CACHE_EXACT_ENABLED=true
CACHE_SEMANTIC_ENABLED=true
# Cosine similarity threshold for semantic cache hits (0.0 to 1.0)
CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.88
CACHE_MAX_ENTRIES=1000

# Optimization Settings
ENABLE_PROMPT_COMPRESSION=true
ENABLE_MODEL_CASCADING=true
COMPRESSION_MAX_LENGTH=4000
